# Copy to .env.local and fill in, off stream. Never commit .env.local.

# Figma export (tools/figma-export.mjs)
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# The Supabase project for shared cabinets: Project Settings → API.
# Locally: `npx supabase status` (http://<this computer's LAN address>:55321 for a phone).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
