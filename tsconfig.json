{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The domain layer imports its siblings with a .ts extension, so the same
    // files run in plain Node for the tests.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
